DIM corre_x , corre_y, passo , timer_passo , cor_atual


COLOR_TEST: PROCEDURE
    MODE 1
    WAIT

    SCREEN screen_cards_test_block

    WHILE CONT: WAIT: WEND

    WAIT
    WHILE CONT = 0: WAIT: WEND
    WHILE CONT: WAIT: WEND

    DEFINE 0,16,screen_bitmaps_test_text_0
    WAIT
    DEFINE 16,9,screen_bitmaps_test_text_1
    WAIT
    SCREEN screen_cards_test_text

    WAIT
    WHILE CONT = 0: WAIT: WEND
    WHILE CONT: WAIT: WEND

CLS
WAIT
DEFINE DEF00,16,Graphics_run
WAIT

SCREEN screen_cards_test_block
WAIT


corre_x = 1
corre_y = 8
passo = 0
timer_passo = 0
cor_atual = 0

MAIN_LOOP:
    WAIT

    timer_passo = timer_passo + 1
    IF timer_passo >= 4 THEN
        timer_passo = 0
        passo = (passo + 1) AND 7
        
        IF passo = 0 THEN
            cor_atual = (cor_atual + 1) AND 15
        END IF
    END IF

    corre_x = corre_x + 1
    IF corre_x > 160 THEN
        corre_x = 1
        corre_y = corre_y + 4
        
        IF corre_y > 88 THEN corre_y = 8 
    END IF

    SPRITE 0, corre_x + VISIBLE + ZOOMX2, corre_y + ZOOMY2 + DOUBLEY, (SPR00 + passo * 16) + cor_atual + BEHIND

    IF CONT = 0 THEN
        GOTO MAIN_LOOP
    END IF

    WAIT
    WHILE CONT = 0: WAIT: WEND
    WHILE CONT: WAIT: WEND

    WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT:WAIT
    POKE(ADDRESS_cmd), CMD_RESET

    RETURN

    END

